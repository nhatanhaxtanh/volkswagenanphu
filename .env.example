# JWT — đổi thành chuỗi ngẫu nhiên dài ít nhất 32 ký tự
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Gmail — dùng App Password (không phải mật khẩu thường)
# Tạo App Password tại: https://myaccount.google.com/apppasswords
GMAIL_USERNAME=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Email nhận thông báo đăng ký lái thử
NOTIFICATION_EMAIL=your-email@gmail.com

# Tài khoản admin lần đầu chạy
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@2024!
